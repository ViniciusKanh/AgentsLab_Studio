# Variáveis PÚBLICAS do frontend (embutidas no bundle). Nunca coloque segredos aqui.
VITE_APP_NAME=AgentsLab_Studio
# Endereço inicial do backend. Também pode ser alterado em Configurações.
VITE_API_BASE_URL=http://localhost:8000
# Supabase Auth (login/cadastro). Vazio = modo local de usuário único, sem login.
# Use SOMENTE a chave publicável (sb_publishable_...) — nunca service_role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL do site para os links de e-mail (opcional; padrão = endereço atual do navegador)
VITE_SITE_URL=
