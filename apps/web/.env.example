# Variáveis PÚBLICAS do frontend (embutidas no bundle). Nunca coloque segredos aqui.
VITE_APP_NAME=AgentsLab_Studio
# Endereço inicial do backend local. Também pode ser alterado em Configurações.
# O modo é detectado automaticamente: backend respondendo = real; sem backend = offline (somente visual).
# (VITE_APP_MODE deixou de ser usado na v1.2.)
VITE_API_BASE_URL=http://localhost:8000
