# Backend — variáveis PRIVADAS (nunca expor no frontend). Copie para apps/api/.env.
# Obrigatórias: AGENTSLAB_DATABASE_URL (PostgreSQL) e AGENTSLAB_MASTER_KEY.
AGENTSLAB_ENV=development
AGENTSLAB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost
# Domínios de preview (ex.: https://.*\.vercel\.app|https://.*\.pages\.dev)
AGENTSLAB_CORS_ORIGIN_REGEX=
AGENTSLAB_DATA_DIR=./data
# PostgreSQL (obrigatório — SQLite só nos testes). Opções:
#  Supabase:  postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#  Docker:    postgresql://agentslab:agentslab@localhost:5432/agentslab   (docker compose up -d db)
AGENTSLAB_DATABASE_URL=
AGENTSLAB_DB_SCHEMA=agentslab
# Autenticação Supabase (vazio = modo local de usuário único). Projetos novos: só a URL (JWKS).
AGENTSLAB_SUPABASE_URL=
# Somente projetos com JWT secret legado (HS256)
AGENTSLAB_SUPABASE_JWT_SECRET=
# Cofre das chaves de API: auto (= db com PostgreSQL: criptografadas com a MASTER_KEY no banco) | keyring | file
AGENTSLAB_SECRET_BACKEND=auto
# OBRIGATÓRIA com "db". Gere UMA vez e guarde (perdê-la invalida as chaves salvas): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTSLAB_MASTER_KEY=
AGENTSLAB_OLLAMA_BASE_URL=http://localhost:11434
# Limites de segurança e custo
AGENTSLAB_DEFAULT_PROJECT_BUDGET_USD=2.0
AGENTSLAB_MAX_TASKS_PER_PROJECT=10
AGENTSLAB_MAX_LLM_CALLS_PER_PROJECT=60
AGENTSLAB_MAX_AUTO_REVISIONS=1
AGENTSLAB_TASK_CONCURRENCY=3
# Chaves padrão por variável de ambiente (opcional; só no modo local — nunca compartilhadas entre usuários)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
