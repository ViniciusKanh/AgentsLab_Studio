# Backend — variáveis PRIVADAS (nunca expor no frontend). Todas são opcionais.
AGENTSLAB_ENV=development
AGENTSLAB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost
AGENTSLAB_DATA_DIR=./data
# Vazio = SQLite em ./data/agentslab.db. PostgreSQL: postgresql+psycopg://user:senha@localhost:5432/agentslab
AGENTSLAB_DATABASE_URL=
# Cofre das chaves: keyring (Gerenciador de Credenciais do Windows) | file (Fernet + MASTER_KEY)
AGENTSLAB_SECRET_BACKEND=keyring
# Só para "file". Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTSLAB_MASTER_KEY=
AGENTSLAB_OLLAMA_BASE_URL=http://localhost:11434
# Limites de segurança e custo
AGENTSLAB_DEFAULT_PROJECT_BUDGET_USD=2.0
AGENTSLAB_MAX_TASKS_PER_PROJECT=10
AGENTSLAB_MAX_LLM_CALLS_PER_PROJECT=60
AGENTSLAB_MAX_AUTO_REVISIONS=1
AGENTSLAB_TASK_CONCURRENCY=3
# Chaves padrão por variável de ambiente (opcional; preferível cadastrar pelo app)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
